# URL бекенд-сервера (для локальной разработки)
VITE_API_BASE_URL=http://localhost:8000/api

# URL тайлов карты (OpenStreetMap по умолчанию, без ключа)
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Минимальный и максимальный зум карты
VITE_MAP_MIN_ZOOM=3
VITE_MAP_MAX_ZOOM=12

# Начальный год и конечный год для селектора
VITE_YEAR_MIN=1990
VITE_YEAR_MAX=2025
VITE_YEAR_DEFAULT=2024